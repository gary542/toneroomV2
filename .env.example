# ToneRoom V2 — copy to .env and edit. Never commit a real .env.
# No secrets are stored anywhere else in this repo.

# Where job files live (uploads, outputs, transcripts).
TONEROOM_DATA_DIR=./data
# Where downloaded model files live (NOT in the repo).
TONEROOM_MODELS_DIR=./models

TONEROOM_MAX_UPLOAD_MB=200
TONEROOM_MAX_DURATION_S=300

# Set a long random key before exposing the API. If empty, /v1/* is
# unauthenticated — only do that behind a proxy that authenticates.
TONEROOM_API_KEY=

# ASR (faster-whisper). "small" + int8 on CPU is the VPS default.
TONEROOM_WHISPER_MODEL=small
TONEROOM_WHISPER_DEVICE=cpu
TONEROOM_WHISPER_COMPUTE_TYPE=int8

# TTS: sherpa_pocket (Kyutai Pocket TTS via sherpa-onnx) or none.
TONEROOM_TTS_BACKEND=sherpa_pocket
TONEROOM_POCKET_MODEL_DIR=./models/pocket-tts-int8-2026-01-26

# Lip-sync: none (default) or musetalk (Phase 3, GPU only).
TONEROOM_LIPSYNC_BACKEND=none
TONEROOM_MUSETALK_DIR=./models/musetalk

TONEROOM_WORKERS=1
TONEROOM_RETENTION_HOURS=168
